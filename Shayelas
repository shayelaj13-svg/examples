          <div className="absolute inset-0 pointer-events-none opacity-25" style={{ backgroundImage: `url(${hero.pattern})`, backgroundSize: '600px', mixBlendMode: 'overlay' }} />
        )}
      </div>

      <AssetsPanel hero={hero} setHero={setHero} />

      <div className="grid gap-12">
