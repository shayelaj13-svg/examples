  return (
    <div className="p-6 md:p-10 space-y-10" style={{
      backgroundImage: hero.bg ? `url(${hero.bg})` : undefined,
      backgroundSize: 'cover', backgroundPosition: 'center'
    }}>
      <div className="relative overflow-hidden rounded-3xl border shadow-lg bg-white/70 backdrop-blur">
        <div className="p-6 md:p-10 relative">
          <div className="flex items-center gap-3 mb-3">
            <span>🌞</span>
            <span className="px-2 py-1 rounded-lg bg-rose-200 text-rose-900 text-sm">summer study</span>
          </div>
          <h1 className="text-3xl md:text-5xl font-bold tracking-tight">
            {hero.title} {hero.emoji}
          </h1>
          <p className="text-muted-foreground mt-3 max-w-2xl">
